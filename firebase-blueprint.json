{
  "entities": {
    "UserProfile": {
      "title": "Profil Guru",
      "description": "Data profil pendidik yang disimpan per pengguna berdasarkan Firebase UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID pemilik profil.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Alamat email akun Google guru.",
          "minLength": 3,
          "maxLength": 254
        },
        "namaLengkap": {
          "type": "string",
          "description": "Nama lengkap beserta gelar guru.",
          "minLength": 1,
          "maxLength": 120
        },
        "nip": {
          "type": "string",
          "description": "Nomor Induk Pegawai (opsional/kosong jika belum memiliki).",
          "minLength": 0,
          "maxLength": 30,
          "pattern": "^[0-9\\s\\-]*$"
        },
        "sekolah": {
          "type": "string",
          "description": "Nama satuan pendidikan / sekolah tempat mengajar.",
          "minLength": 1,
          "maxLength": 150
        },
        "mataPelajaran": {
          "type": "string",
          "description": "Mata pelajaran yang diampu.",
          "minLength": 1,
          "maxLength": 100
        },
        "kelas": {
          "type": "string",
          "description": "Tingkat kelas / fase yang diajar.",
          "minLength": 1,
          "maxLength": 60
        },
        "photoURL": {
          "type": "string",
          "description": "URL foto profil Google (opsional).",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp server saat profil pertama kali dibuat."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp server saat profil terakhir diperbarui."
        }
      },
      "required": [
        "uid",
        "email",
        "namaLengkap",
        "nip",
        "sekolah",
        "mataPelajaran",
        "kelas",
        "createdAt",
        "updatedAt"
      ]
    },
    "BankSoalMeta": {
      "title": "Metadata Paket Soal",
      "description": "Informasi identitas paket soal yang disimpan ke Bank Soal.",
      "type": "object",
      "properties": {
        "judul": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sekolah": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "mapel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "kelas": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": ["judul", "sekolah", "mapel", "kelas"]
    },
    "BankSoalDocument": {
      "title": "Dokumen Bank Soal",
      "description": "Paket soal hasil generator yang disimpan guru ke koleksi bank_soal.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Authentication UID pemilik paket soal.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp server saat paket soal disimpan."
        },
        "meta": {
          "$ref": "#/entities/BankSoalMeta",
          "description": "Metadata ujian."
        },
        "soal": {
          "type": "array",
          "description": "Daftar butir soal (maksimal 100 butir per paket)."
        }
      },
      "required": ["userId", "createdAt", "meta", "soal"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Dokumen profil guru pribadi yang diindeks dengan Firebase UID."
    },
    "/bank_soal/{soalId}": {
      "schema": {
        "$ref": "#/entities/BankSoalDocument"
      },
      "description": "Koleksi paket soal tersimpan milik masing-masing guru."
    }
  }
}
